CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
# Rotate UI pixels counterclockwise; TB321FU native panel is 1600x2560 portrait
# and the desktop runs landscape, matching the Gen4 verified 270 rotation.
CONFIG_KSHIM_UI_ROTATION_CCW=270
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# Sized for 3040-pixel rows on Gen4; TB321FU rows are 2560 px, comfortably inside.
CONFIG_KSHIM_LVGL_BUFFER_BYTES=243712
# CONFIG_KSHIM_TOUCH is not set
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
CONFIG_KSHIM_MENU_SESSION_SETTINGS=y

CONFIG_KSHIM_MENU_CHINESE=y
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
CONFIG_KSHIM_MENU_BASE_ANDROID=y
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
# CONFIG_KSHIM_BOOT_TIMING is not set

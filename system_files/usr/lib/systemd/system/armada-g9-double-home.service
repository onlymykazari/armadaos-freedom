[Unit]
Description=double-Home to Steam Quick Access Menu helper (TB323FU Gen5 G9 2026 / TB322FC Gen4 G9)
After=inputplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/armada/armada-g9-double-home.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

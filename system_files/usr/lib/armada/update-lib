#!/bin/bash
# Shared helpers for the armada update hooks (steamos-update, steamos-select-branch).

# Freedom is the only update target. The two old upstream origins are still
# recognized so booted deployments can migrate onto Freedom.
ARMADA_CANONICAL_REGISTRY="ghcr.io/mydanyi/armadaos-freedom"
ARMADA_UPSTREAM_REGISTRY="ghcr.io/armada-os/armada"
ARMADA_LEGACY_REGISTRY="ghcr.io/virtudude/armada"
ARMADA_UPDATE_POLICY="${ARMADA_UPDATE_POLICY:-/etc/containers/policy.json}"
ARMADA_CHANNEL_STATE="/var/lib/armada/update-channel"
ARMADA_CHANNELS="stable beta testing"
ARMADA_OSTREE_REPO="/ostree/repo"
ARMADA_UPDATE_RESERVE_GIB=2
ARMADA_UPDATE_RESERVE_SIZE="${ARMADA_UPDATE_RESERVE_GIB}GB"
ARMADA_UPDATE_RESERVE_BYTES=$((ARMADA_UPDATE_RESERVE_GIB * 1024 * 1024 * 1024))

armada_update_log() {
    echo "armada-update: $*" >&2
    logger -t armada-update -- "$*" 2>/dev/null || true
}

# Steam's picker speaks Valve's branch tokens; translate to/from our ghcr tags.
armada_token_to_channel() {
    case "$1" in
        rel|latest|stable) echo stable ;;
        beta)               echo beta ;;
        rc|bc|main|preview|testing) echo testing ;;
        *) return 1 ;;
    esac
}
armada_channel_to_token() {
    case "$1" in
        beta)    echo beta ;;
        testing) echo preview ;;
        *)       echo rel ;;
    esac
}

# Tag from a container ref, stripping any @digest and transport/registry prefix.
armada_tag_from_ref() {
    local r="${1%@*}"; r="${r##*/}"
    [[ "$r" == *:* ]] && echo "${r##*:}" || echo ""
}

# Exact repository matches prevent lookalike names from being trusted.
armada_registry_from_ref() {
    local r="$1"
    case "$r" in
        ostree-unverified-registry:*) r="${r#ostree-unverified-registry:}" ;;
    esac
    r="${r##*://}"
    r="${r%%@*}"
    [[ "${r##*/}" == *:* ]] && r="${r%:*}"
    case "$r" in
        "$ARMADA_CANONICAL_REGISTRY"|"$ARMADA_UPSTREAM_REGISTRY"|"$ARMADA_LEGACY_REGISTRY") echo "$r" ;;
    esac
}

# Non-registry transports cannot be checked for network updates. Only
# well-formed, supported transports are parsed; a generic repository is kept so
# external tests can exercise the parser, but it never remaps the result.
armada_repository_from_ref() {
    local r
    case "$1" in
        ostree-image-signed:docker://*) r="${1#ostree-image-signed:docker://}" ;;
        ostree-unverified-image:docker://*) r="${1#ostree-unverified-image:docker://}" ;;
        ostree-unverified-registry:docker://*) r="${1#ostree-unverified-registry:docker://}" ;;
        ostree-unverified-registry:*) r="${1#ostree-unverified-registry:}" ;;
        docker://*) r="${1#docker://}" ;;
        *) return 1 ;;
    esac
    r="${r%%@*}"
    [[ "${r##*/}" == *:* ]] && r="${r%:*}"
    [[ -n "$r" && "$r" == */* && "$r" != *[[:space:]]* && "$r" != *:* ]] || return 1
    echo "$r"
}

# Structural validation shared by the ref parsers, run before any tag/digest is
# stripped: a dangling tag colon, a repeated "@", or an "@" that is not a
# non-empty hex sha256 digest would otherwise be discarded and silently
# mistaken for a valid ref. Supported transports are stripped here; raw refs
# (how bootc reports staged images) are allowed; whitespace, unknown "*://"
# transports, and a bare transport prefix are rejected.
armada_ref_validate() {
    local ref="$1"
    [[ -n "$ref" && "$ref" != *[[:space:]]* ]] || return 1
    case "$ref" in
        ostree-image-signed:docker://*) ref="${ref#ostree-image-signed:docker://}" ;;
        ostree-unverified-image:docker://*) ref="${ref#ostree-unverified-image:docker://}" ;;
        ostree-unverified-registry:docker://*) ref="${ref#ostree-unverified-registry:docker://}" ;;
        ostree-unverified-registry:*) ref="${ref#ostree-unverified-registry:}" ;;
        docker://*) ref="${ref#docker://}" ;;
        *://*) return 1 ;;
    esac
    [[ -n "$ref" ]] || return 1
    case "$ref" in
        *@*)
            [[ "${ref#*@}" != *@* ]] || return 1
            [[ "${ref#*@}" =~ ^sha256:[0-9a-fA-F]+$ ]] || return 1
            ref="${ref%%@*}"
            ;;
    esac
    [[ -n "$ref" ]] || return 1
    if [[ "${ref##*/}" == *:* ]]; then
        [[ -n "${ref##*:}" ]] || return 1
    fi
    return 0
}

# "<repository> <tag>" for a raw or transport container ref; the tag is empty
# when the ref carries none. Raw refs have no transport prefix, which is how
# bootc reports staged images, so they are accepted here. Prints nothing and
# returns non-zero for unsupported or malformed input so an unknown staged
# source can never be mistaken for a supported one.
armada_ref_parts() {
    local ref="$1" repository tag
    armada_ref_validate "$ref" || return 1
    case "$ref" in
        ostree-image-signed:docker://*) ref="${ref#ostree-image-signed:docker://}" ;;
        ostree-unverified-image:docker://*) ref="${ref#ostree-unverified-image:docker://}" ;;
        ostree-unverified-registry:docker://*) ref="${ref#ostree-unverified-registry:docker://}" ;;
        ostree-unverified-registry:*) ref="${ref#ostree-unverified-registry:}" ;;
        docker://*) ref="${ref#docker://}" ;;
        *://*) return 1 ;;
    esac
    ref="${ref%%@*}"
    tag=""
    if [[ "${ref##*/}" == *:* ]]; then
        tag="${ref##*:}"
        ref="${ref%:*}"
    fi
    repository="$ref"
    [[ -n "$repository" && "$repository" == */* && "$repository" != *:* ]] || return 1
    printf '%s %s\n' "$repository" "$tag"
}

armada_steam_channels_apply() {
    local channel
    case "$1" in
        "$ARMADA_CANONICAL_REGISTRY"|"$ARMADA_UPSTREAM_REGISTRY"|"$ARMADA_LEGACY_REGISTRY") ;;
        *) return 1 ;;
    esac
    for channel in ${ARMADA_CHANNELS}; do
        [[ "$2" == "$channel" ]] && return 0
    done
    return 1
}

# Raw container-image-reference of the booted deployment. rpm-ostree works
# unprivileged (bootc status needs root), so the -c query can call this.
armada_booted_ref() {
    rpm-ostree status --booted --json 2>/dev/null | python3 -c \
        'import sys,json; d=json.load(sys.stdin).get("deployments") or [{}]; print(d[0].get("container-image-reference",""))' 2>/dev/null || true
}
armada_booted_channel() { armada_tag_from_ref "$(armada_booted_ref)"; }
armada_booted_registry() { armada_registry_from_ref "$(armada_booted_ref)"; }

# Raw image ref of the staged (next-boot) deployment, if any. Needs root.
armada_staged_ref() {
    bootc status --format json 2>/dev/null | python3 -c \
        'import sys,json; st=json.load(sys.stdin).get("status",{}).get("staged"); print(st["image"]["image"]["image"] if st else "")' 2>/dev/null || true
}

# "<booted-digest> <staged-digest> <staged-ref> <staged-version>", "-" keeps
# empty fields positional. Needs root.
armada_local_state() {
    bootc status --format json 2>/dev/null | python3 -c '
import sys, json
st = json.load(sys.stdin).get("status") or {}
b = (st.get("booted") or {}).get("image") or {}
s = (st.get("staged") or {}).get("image") or {}
out = [b.get("imageDigest"), s.get("imageDigest"), (s.get("image") or {}).get("image"), s.get("version")]
print(" ".join(v or "-" for v in out))
' 2>/dev/null || true
}

# "<missing-layer-bytes> <digest> <version-label-or-dash>" for a channel's
# published image. Full skopeo inspection resolves an image index to this host's
# platform and provides layer sizes without a second registry request. Only the
# canonical Freedom repository on a supported channel is ever inspected. When
# the repository argument is omitted it is resolved from the booted ref through
# armada_update_target; that failure returns non-zero without contacting skopeo,
# and there is no fallback to an upstream origin.
armada_remote_info() {
    local tag="$1" repository="${2:-}" target desired
    if [[ -z "${repository}" ]]; then
        target="$(armada_update_target "$(armada_booted_ref)")" || return 1
        read -r repository desired <<<"${target}"
        tag="${desired}"
    fi
    [[ "${repository}" == "${ARMADA_CANONICAL_REGISTRY}" ]] || return 1
    armada_steam_channels_apply "${repository}" "${tag}" || return 1
    skopeo inspect "docker://${repository}:${tag}" 2>/dev/null | \
        python3 -c '
import json
import subprocess
import sys

try:
    image = json.load(sys.stdin)
    digest = image["Digest"]
    layers = image["LayersData"]
    labels = image.get("Labels") or {}
    version = labels.get("org.opencontainers.image.version") or "-"
    if (not isinstance(digest, str) or not digest or not isinstance(version, str)
            or "\n" in version or "\r" in version):
        raise ValueError
    if not isinstance(layers, list):
        raise ValueError
except (KeyError, ValueError):
    raise SystemExit(1)

try:
    refs = set(subprocess.check_output(
        ["ostree", "--repo=" + sys.argv[1], "refs"],
        stderr=subprocess.DEVNULL,
        text=True,
    ).splitlines())
except (OSError, subprocess.SubprocessError):
    raise SystemExit(2)

try:
    required = 0
    for layer in layers:
        layer_digest = layer["Digest"]
        size = layer["Size"]
        if not isinstance(layer_digest, str) or not isinstance(size, int) or size < 0:
            raise ValueError
        ref = "ostree/container/blob/" + layer_digest.replace(":", "_3A_", 1)
        if ref not in refs:
            required += size
except (KeyError, ValueError):
    raise SystemExit(1)

print(required, digest, version)
' "${ARMADA_OSTREE_REPO}"
}

armada_log_remote_info_failure() {
    if [[ "$1" == 2 ]]; then
        armada_update_log "could not read local OSTree layer references"
    else
        armada_update_log "could not inspect update target $2"
    fi
}

armada_filesystem_bytes() {
    local block_size blocks
    read -r block_size blocks < <(
        stat -f -c "%S $1" "${ARMADA_OSTREE_REPO}" 2>/dev/null
    ) || return 1
    [[ "${block_size}" =~ ^[0-9]+$ && "${blocks}" =~ ^[0-9]+$ ]] || return 1
    echo $((block_size * blocks))
}

armada_available_bytes() {
    # OSTree enforces its reserve against f_bfree, not non-root f_bavail.
    armada_filesystem_bytes %f
}

armada_total_bytes() {
    armada_filesystem_bytes %b
}

# Until the fixed-reserve migration succeeds, OSTree retains its 3% default.
# Keep the availability check at least as conservative as either reserve.
armada_fallback_reserve_bytes() {
    local total percent
    total="$(armada_total_bytes)" || return 1
    [[ "${total}" =~ ^[0-9]+$ ]] || return 1
    percent=$(((total * 3 + 99) / 100))
    if (( percent > ARMADA_UPDATE_RESERVE_BYTES )); then
        echo "${percent}"
    else
        echo "${ARMADA_UPDATE_RESERVE_BYTES}"
    fi
}

armada_update_reserve_bytes() {
    local current
    current="$(ostree config --repo="${ARMADA_OSTREE_REPO}" \
        get core.min-free-space-size 2>/dev/null || true)"
    if [[ "${current}" == "${ARMADA_UPDATE_RESERVE_SIZE}" ]]; then
        echo "${ARMADA_UPDATE_RESERVE_BYTES}"
        return
    fi
    armada_update_log "fixed OSTree reserve migration is not active; using the larger of ${ARMADA_UPDATE_RESERVE_GIB} GiB and OSTree's 3% default"
    armada_fallback_reserve_bytes || {
        armada_update_log "could not compute fallback OSTree reserve"
        return 1
    }
}

# Return success only when bootc can fetch every missing layer and still leave
# the configured reserve. A fully cached target remains valid below the reserve.
armada_update_fits() {
    local required="$1" reserve="${2:-$ARMADA_UPDATE_RESERVE_BYTES}" avail usable
    if ! [[ "${required}" =~ ^[0-9]+$ && "${reserve}" =~ ^[0-9]+$ ]]; then
        armada_update_log "could not compute target update storage requirement"
        return 2
    fi
    if ! avail="$(armada_available_bytes)"; then
        armada_update_log "could not determine available update storage"
        return 2
    fi
    if ! [[ "${avail}" =~ ^[0-9]+$ ]]; then
        armada_update_log "could not determine available update storage"
        return 2
    fi
    if (( avail > reserve )); then
        usable=$((avail - reserve))
    else
        usable=0
    fi
    (( required <= usable )) && return 0
    armada_update_log "update does not fit: ${required} bytes needed plus ${reserve} bytes reserved; ${avail} bytes available"
    return 1
}

# Channel the user selected, validated to a known channel; otherwise a
# fallback tag. Called with an argument (even an explicit empty string) the
# fallback is only that supplied tag and the booted channel is never
# re-queried, so a digest-only ref with no valid stored channel fails in the
# caller. Called with no argument (armada-select-branch -c) the fallback is the
# booted channel, so the current branch is still displayed.
armada_desired_channel() {
    local c="" fallback ch
    if (( $# > 0 )); then
        fallback="$1"
    else
        fallback="$(armada_booted_channel)"
    fi
    [[ -r "$ARMADA_CHANNEL_STATE" ]] && read -r c < "$ARMADA_CHANNEL_STATE" 2>/dev/null
    # Exact-match a known channel (a substring/glob test would accept a corrupt
    # multi-word value and feed it to bootc as a tag).
    for ch in ${ARMADA_CHANNELS}; do
        [[ "$c" == "$ch" ]] && { echo "$c"; return; }
    done
    [[ -n "$fallback" ]] && echo "$fallback"
}

# Resolve the ref of the booted deployment to the Freedom repository and the
# desired channel. Unknown repositories, unsupported transports, empty refs,
# unsupported feature tags, and digest-only refs with no valid stored channel
# are all rejected. A valid selected channel overrides a valid booted tag; a
# non-empty tag that is not a known channel is rejected rather than remapped.
armada_update_target() {
    local ref="$1" booted repository desired
    armada_ref_validate "$ref" || return 1
    booted="$(armada_tag_from_ref "$ref")"
    repository="$(armada_repository_from_ref "$ref")" || return 1
    case "$repository" in
        "$ARMADA_CANONICAL_REGISTRY"|"$ARMADA_UPSTREAM_REGISTRY"|"$ARMADA_LEGACY_REGISTRY") ;;
        *) return 1 ;;
    esac
    if [[ -n "$booted" ]] && ! armada_steam_channels_apply "$repository" "$booted"; then
        return 1
    fi
    desired="$(armada_desired_channel "$booted")"
    [[ -n "$desired" && "$desired" != *[[:space:]]* ]] || return 1
    printf '%s %s\n' "$ARMADA_CANONICAL_REGISTRY" "$desired"
}

# Success only when the containers policy pins the canonical Freedom repository
# to a sigstoreSigned requirement with a non-empty keyPaths list whose string
# entries are all existing regular files. This proves the signature
# configuration is present; bootc still enforces the cryptography at switch
# time. Missing/malformed JSON, a missing or wrong-typed requirement, or a
# missing key file all fail.
armada_update_policy_ready() {
    [[ -r "${ARMADA_UPDATE_POLICY}" ]] || return 1
    python3 - "${ARMADA_UPDATE_POLICY}" "${ARMADA_CANONICAL_REGISTRY}" <<'PY'
import json
import os
import sys

try:
    with open(sys.argv[1]) as stream:
        requirements = json.load(stream)["transports"]["docker"][sys.argv[2]]
except (OSError, ValueError, KeyError, TypeError):
    raise SystemExit(1)

if not isinstance(requirements, list):
    raise SystemExit(1)
for requirement in requirements:
    if not isinstance(requirement, dict) or requirement.get("type") != "sigstoreSigned":
        continue
    key_paths = requirement.get("keyPaths")
    if not isinstance(key_paths, list) or not key_paths:
        continue
    if all(isinstance(path, str) and os.path.isfile(path) for path in key_paths):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# Run a bootc command with progress wired to the Steam N% translator. fd 3 must
# be a pipe; use a 0700 tmpdir so the FIFO can't be pre-created by another user.
armada_bootc_with_progress() {
    local dir rc reader
    dir="$(mktemp -d 2>/dev/null)" || { "$@" 1>&2; return $?; }
    mkfifo "$dir/p" 2>/dev/null || { rm -rf "$dir"; "$@" 1>&2; return $?; }
    /usr/libexec/armada/update-progress < "$dir/p" &
    reader=$!
    # bootc's own stdout -> stderr; only the translator's N% reaches Steam.
    "$@" --progress-fd 3 3>"$dir/p" 1>&2; rc=$?
    wait "$reader" 2>/dev/null
    rm -rf "$dir"
    return "$rc"
}

From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] drm/panel: nt36523: add the Lenovo TB321FU kirby CSOT + BOE DSC panels

Port of GUF296's kirby support (github.com/GUF296/linux, TB321FU-7.1.1) plus
the BOE variant (Legion Tab Gen 3 units with a BOE panel), known-good on the
device with the 7.1.1 kernel. Re-expressed for Freedom's multi-context
nt36523 driver: the kirby panels run the link compressed (DSC 1.1) with the
downstream per-controller PPS view, take display-on after the DSC block, and
declare a VRR range with the 165/144/120/90/60 Hz VFP mode ladder. Folds the
upstream 0810/0811/0813/0839 rate patches; the standalone kirby CSOT driver
(0800) is not carried, the shared driver binds the panels.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -53,6 +53,17 @@
 	/* Panels that run the link compressed point this at their config. */
 	const struct drm_dsc_config *dsc_cfg;
 	int (*init_sequence)(struct panel_info *pinfo);
+	/* Panels that must not display before the link is commissioned send
+	 * their display-on from here, after the DSC block, instead of ending
+	 * the init sequence with it. */
+	int (*display_on_sequence)(struct panel_info *pinfo);
+	/* Pack the PPS with the downstream per-controller view (pic_width =
+	 * slice_width, one slice per link) while dsi->dsc keeps the bonded
+	 * frame for the DPU. */
+	bool pps_per_controller;
+	/* Advertise this VRR lower bound together with the modes' highest
+	 * refresh rate. */
+	unsigned int vrr_min_hz;
 
 	bool is_dual_dsi;
 	bool has_dcs_backlight;
@@ -1020,9 +1031,19 @@
 
 	if (pinfo->desc->dsc_cfg) {
 		struct drm_dsc_picture_parameter_set pps;
+		struct drm_dsc_config pps_dsc;
 		int i;
 
-		drm_dsc_pps_payload_pack(&pps, pinfo->dsc);
+		if (pinfo->desc->pps_per_controller) {
+			/* Downstream programs one 800-pixel slice per physical link
+			 * while the MSM host-side config keeps the bonded frame. */
+			pps_dsc = *pinfo->dsc;
+			pps_dsc.pic_width = pps_dsc.slice_width;
+			pps_dsc.slice_count = 1;
+			drm_dsc_pps_payload_pack(&pps, &pps_dsc);
+		} else {
+			drm_dsc_pps_payload_pack(&pps, pinfo->dsc);
+		}
 
 		for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
 			struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i] };
@@ -1038,6 +1059,15 @@
 		}
 	}
 
+	if (pinfo->desc->display_on_sequence) {
+		ret = pinfo->desc->display_on_sequence(pinfo);
+		if (ret < 0) {
+			regulator_disable(pinfo->vddio);
+			dev_err(panel->dev, "failed to set display on: %d\n", ret);
+			return ret;
+		}
+	}
+
 	return 0;
 }
 
@@ -1133,6 +1163,20 @@
 	connector->display_info.width_mm = pinfo->desc->width_mm;
 	connector->display_info.height_mm = pinfo->desc->height_mm;
 	connector->display_info.bpc = pinfo->desc->bpc;
+	if (pinfo->desc->vrr_min_hz) {
+		unsigned int max_hz = 0;
+
+		for (i = 0; i < pinfo->desc->num_modes; i++) {
+			const struct drm_display_mode *m = &pinfo->desc->modes[i];
+
+			max_hz = max_t(unsigned int, max_hz,
+				       DIV_ROUND_UP(m->clock * 1000,
+						    m->htotal * m->vtotal));
+		}
+		connector->display_info.monitor_range.min_vfreq = pinfo->desc->vrr_min_hz;
+		connector->display_info.monitor_range.max_vfreq = max_hz;
+		drm_connector_set_vrr_capable_property(connector, true);
+	}
 
 	if (pinfo->desc == &baldur_csot_desc) {
 		for (i = 0; i < ARRAY_SIZE(baldur_csot_extra_modes); i++) {
@@ -1440,11 +1484,293 @@
 		      MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT, /* vendor slice-per-pkt = 2 */
 	.dsc_cfg = &baldur_csot_dsc_cfg,
 	.init_sequence = baldur_csot_init_sequence,
+	.is_dual_dsi = true,
+};
+
+/*
+ * Lenovo TB321FU (kirby) NT36523 panels, BOE and CSOT variants. Both are
+ * dual-DSI C-PHY video panels with DSC 1.1; the init sequences and the
+ * display-on-after-DSC requirement come from the Android bootloader's
+ * qcom,mdss_dsi_kirby_nt36523_{boe,csot}_dsc_vid nodes (verified on
+ * hardware by the armada-tb321fu project).
+ */
+static const struct drm_dsc_config kirby_dsc_cfg = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 1,
+	.pic_width = 1600,
+	.pic_height = 2560,
+	.slice_height = 20,
+	.slice_width = 800,
+};
+
+static int kirby_csot_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	/* Lenovo TB321FU Android qcom,mdss_dsi_kirby_nt36523_csot_dsc_vid */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf0, 0xaa);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf1, 0x55);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x0f, 0x20);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x27);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd0, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd1, 0x54);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xde, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xdf, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xd0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x00, 0x30);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x09, 0xee);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1c, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1d, 0x09);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x24, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x17, 0xcf);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x19, 0x1f);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1b, 0x5b);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1c, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf3, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x35, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x51, 0x07, 0xff);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x53, 0x2c);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x55, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x90, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x91,
+				    0x89, 0x28, 0x00, 0x14, 0xc2, 0x00, 0x02,
+				    0x91, 0x02, 0x47, 0x00, 0x0b, 0x05, 0x0e,
+				    0x03, 0x68);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x92, 0x10, 0xe0);
+	/*
+	 * Run the panel in its 165 Hz class (stock dispparam-pen-165hz-power-on-command,
+	 * same B2/B3 as the BOE panel); lower rates come from a longer VFP at the same
+	 * link clock, like Android's dfps_immediate_porch_mode_vfp.
+	 */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb2, 0x80);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb3, 0x20);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xbb, 0x13);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x3b,
+				    0x03, 0x04, 0x1e, 0x04, 0x04, 0x01);
+	mipi_dsi_dual(mipi_dsi_dcs_exit_sleep_mode_multi, &dsi_ctx, dsi0, dsi1);
+	mipi_dsi_msleep(&dsi_ctx, 105);
+
+	return dsi_ctx.accum_err;
+}
+
+static int kirby_display_on_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x29);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf0, 0x55);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf1, 0xaa);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x66);
+
+	return dsi_ctx.accum_err;
+}
+
+static int kirby_boe_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	/* Lenovo TB321FU Android qcom,mdss_dsi_kirby_nt36523_boe_dsc_vid */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf0, 0xaa);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf1, 0x55);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x0f, 0x20);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x27);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd0, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd1, 0x54);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xde, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xdf, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xd0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x00, 0x30);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x09, 0xee);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1c, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1d, 0x09);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x24, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x17, 0xcf);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x19, 0x1f);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1b, 0x5b);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x35, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x3b,
+					  0x03, 0x04, 0x1e, 0x04, 0x04, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x51, 0x0f, 0xff);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x53, 0x2c);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x55, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x90, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x91,
+					  0x89, 0x28, 0x00, 0x14, 0xc2, 0x00, 0x02, 0x91, 0x02,
+					  0x47, 0x00, 0x0b, 0x05, 0x0e, 0x03, 0x68);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x92, 0x10, 0xe0);
+	/*
+	 * Run the panel in its 165 Hz class (stock dispparam-pen-165hz-power-on-command);
+	 * lower rates come from a longer VFP at the same link clock, like Android's
+	 * dfps_immediate_porch_mode_vfp.
+	 */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb2, 0x80);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb3, 0x20);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xbb, 0x13);
+	mipi_dsi_dual(mipi_dsi_dcs_exit_sleep_mode_multi, &dsi_ctx, dsi0, dsi1);
+	mipi_dsi_msleep(&dsi_ctx, 105);
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * htotal 2314; pixel clock 2314 * 2850 * 165 Hz. Each of the two layer mixers
+ * drives 800 px, so the MDP core needs ~395 MHz (max 514 MHz).
+ */
+#define KIRBY_BOE_165_CLOCK	1088159
+#define KIRBY_BOE_MODE(vfp)						\
+	{								\
+		.clock = KIRBY_BOE_165_CLOCK,				\
+		.hdisplay = 1600,					\
+		.hsync_start = 1600 + 566,				\
+		.hsync_end = 1600 + 566 + 40,				\
+		.htotal = 1600 + 566 + 40 + 108,			\
+		.vdisplay = 2560,					\
+		.vsync_start = 2560 + (vfp),				\
+		.vsync_end = 2560 + (vfp) + 2,				\
+		.vtotal = 2560 + (vfp) + 2 + 258,			\
+	}
+
+static const struct drm_display_mode kirby_boe_modes[] = {
+	KIRBY_BOE_MODE(30),	/* 165 Hz, preferred */
+	KIRBY_BOE_MODE(446),	/* 144 Hz */
+	KIRBY_BOE_MODE(1099),	/* 120 Hz */
+	KIRBY_BOE_MODE(2405),	/*  90 Hz */
+	KIRBY_BOE_MODE(5018),	/*  60 Hz */
+};
+
+/*
+ * htotal 2314; pixel clock 2314 * 2850 * 165 Hz, as on the BOE panel (same stock
+ * timings apart from the vertical sync/back porch split).
+ */
+#define KIRBY_CSOT_165_CLOCK	1088159
+#define KIRBY_CSOT_MODE(vfp)						\
+	{								\
+		.clock = KIRBY_CSOT_165_CLOCK,				\
+		.hdisplay = 1600,					\
+		.hsync_start = 1600 + 566,				\
+		.hsync_end = 1600 + 566 + 40,				\
+		.htotal = 1600 + 566 + 40 + 108,			\
+		.vdisplay = 2560,					\
+		.vsync_start = 2560 + (vfp),				\
+		.vsync_end = 2560 + (vfp) + 4,				\
+		.vtotal = 2560 + (vfp) + 4 + 256,			\
+	}
+
+static const struct drm_display_mode kirby_csot_modes[] = {
+	KIRBY_CSOT_MODE(30),	/* 165 Hz, preferred */
+	KIRBY_CSOT_MODE(446),	/* 144 Hz */
+	KIRBY_CSOT_MODE(1099),	/* 120 Hz */
+	KIRBY_CSOT_MODE(2405),	/*  90 Hz */
+	KIRBY_CSOT_MODE(5018),	/*  60 Hz */
+};
+
+static const struct panel_desc kirby_csot_desc = {
+	.modes = kirby_csot_modes,
+	.num_modes = ARRAY_SIZE(kirby_csot_modes),
+	.dsi_info = {
+		.type = "nt36523-kirby",
+		.channel = 0,
+		.node = NULL,
+	},
+	.width_mm = 118,
+	.height_mm = 190,
+	.bpc = 8,
+	.lanes = 3,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.dsc_cfg = &kirby_dsc_cfg,
+	.init_sequence = kirby_csot_init_sequence,
+	.display_on_sequence = kirby_display_on_sequence,
+	.pps_per_controller = true,
 	.is_dual_dsi = true,
+	.vrr_min_hz = 60,
 };
 
+static const struct panel_desc kirby_boe_desc = {
+	.modes = kirby_boe_modes,
+	.num_modes = ARRAY_SIZE(kirby_boe_modes),
+	.dsi_info = {
+		.type = "nt36523-kirby-boe",
+		.channel = 0,
+		.node = NULL,
+	},
+	.width_mm = 118,
+	.height_mm = 190,
+	.bpc = 8,
+	.lanes = 3,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.dsc_cfg = &kirby_dsc_cfg,
+	.init_sequence = kirby_boe_init_sequence,
+	.display_on_sequence = kirby_display_on_sequence,

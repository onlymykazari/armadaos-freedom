# ---- Qualcomm interconnect dependencies preserved explicitly ----
# The mass-trim above removes the Kconfig contexts that normally carry these
# =y requests; re-anchor the SM8650-essential stack so merge_config's strict
# verification passes (QRTR -> QMI -> PDR/APR -> clk/phy/soc drivers).
CONFIG_NET=y
CONFIG_PCI=y
CONFIG_MAILBOX=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_GCC_8650=y
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_VIDEOCC_8550=y
CONFIG_SM_CAMCC_8550=y
CONFIG_PHY_QCOM_QMP_PCIE=y
# Visible boot: the kShimC handoff adds a simple-framebuffer node; without a
# driver for it the diagnostic kernel boots headless (observed: silent black
# screen after selecting the diagnostic entry).
CONFIG_DRM_SIMPLEDRM=y
# Black-box: the DTS ramoops node (splash reservation tail) + pstore console
# capture the early kernel log for post-mortem from Android.
CONFIG_PSTORE_RAM=y
# Diagnostic payload: keep the simpledrm framebuffer for the whole session.
# Hardware evidence: with DRM_MSM enabled the boot shows one fbcon frame and
# then goes dark (MSM DPU probe takes over the scanout and the panel init
# fails), hiding the report; the text diagnostic needs no MSM display.
# CONFIG_DRM_MSM is not set

# ---- Misc large subsystems the diagnostic payload does not need ----
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_FPGA is not set
# CONFIG_STAGING is not set
# CONFIG_GPIO_AGGREGATOR is not set
# CONFIG_SENSORS_LIS3_I2C is not set
# CONFIG_EXT2_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_SWAP is not set

# ---- Debug/trace weight ----
# (DYNAMIC_DEBUG stays: the armada overrides request it =y and FTRACE-off
# would silently demote it, failing the strict =y verification.)
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_USER_NS is not set
# CONFIG_MODULE_SIG is not set
